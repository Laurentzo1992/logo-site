# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Set to True once the site is actually served over HTTPS (reverse proxy/PaaS
# terminating TLS) — enables SSL redirect, HSTS and secure cookies.
USE_HTTPS=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database (used by docker-compose to provision Postgres and by Django to connect)
DB_NAME=logosite
DB_USER=logosite
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
# Alternatively, set a single DATABASE_URL (takes precedence if provided
# via the platform, e.g. postgres://user:password@host:5432/dbname)
# DATABASE_URL=

# Email (OVH SMTP)
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=change-me
