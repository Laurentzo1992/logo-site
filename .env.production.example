# Modèle pour le VPS de production. Copier en ".env" sur le serveur
# (à côté de docker-compose.prod.yml) puis renseigner les valeurs marquées
# CHANGE-MOI. Ne jamais committer le ".env" réel.

# Django
SECRET_KEY=CHANGE-MOI-genere-avec-la-commande-plus-bas
DEBUG=False
USE_HTTPS=True
ALLOWED_HOSTS=logo-services.com,www.logo-services.com
CSRF_TRUSTED_ORIGINS=https://logo-services.com,https://www.logo-services.com

# Base de données (utilisée par docker-compose pour créer Postgres et par Django pour s'y connecter)
DB_NAME=logosite
DB_USER=logosite
DB_PASSWORD=CHANGE-MOI-mot-de-passe-fort-different-du-local

# Email (SMTP OVH — vrais identifiants, pas les placeholders du dev local)
EMAIL_HOST_USER=CHANGE-MOI@logo-services.com
EMAIL_HOST_PASSWORD=CHANGE-MOI

# Veille RSS du blog (optionnel, 3600 = toutes les heures par défaut)
FETCH_NEWS_INTERVAL_SECONDS=3600
